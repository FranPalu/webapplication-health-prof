# Configure only on the server. Never commit actual values.
RESEND_API_KEY=
MAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
META_GRAPH_VERSION=
REMINDER_JOB_SECRET=
# Enable only after fiscal configuration and validation
FISCAL_ISSUANCE_ENABLED=false
# Activate only after testing the channels and configuring the scheduler
REMINDER_AUTOMATION_ENABLED=false
WHATSAPP_LANGUAGE=it
RESEND_WEBHOOK_SECRET=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# M1 Django/Compose: make env generates local secrets in ignored .env.dev.
# Never use these blank examples as production credentials.
DJANGO_SECRET_KEY=
MFA_ENCRYPTION_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_ORIGIN=http://localhost:8080
POSTGRES_DB=health
POSTGRES_USER=health
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
REDIS_URL=redis://redis:6379/0
EMAIL_HOST=mail
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@health.example
S3_ENDPOINT=http://storage:9000
S3_BUCKET=health-local
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Next local dev only; Compose sends API traffic directly through its proxy.
API_INTERNAL_URL=http://127.0.0.1:8000
