# Configure only on the server. Never commit actual values.
RESEND_API_KEY=
MAIL_FROM=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_ID=
WHATSAPP_TEMPLATE=
META_GRAPH_VERSION=
REMINDER_JOB_SECRET=
# Enable only after fiscal configuration and validation
FISCAL_ISSUANCE_ENABLED=false
# Activate only after testing the channels and configuring the scheduler
REMINDER_AUTOMATION_ENABLED=false
WHATSAPP_LANGUAGE=it
RESEND_WEBHOOK_SECRET=
META_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=

# M1 Django/Compose: make env generates local secrets in ignored .env.dev.
# Never use these blank examples as production credentials.
DJANGO_SECRET_KEY=
MFA_ENCRYPTION_KEY=
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
PUBLIC_ORIGIN=http://localhost:8080
POSTGRES_DB=health
POSTGRES_USER=health
POSTGRES_PASSWORD=
POSTGRES_HOST=db
POSTGRES_PORT=5432
# Seconds to reuse a PostgreSQL connection per WSGI worker. Use 0 to disable.
POSTGRES_CONN_MAX_AGE=60
REDIS_URL=redis://redis:6379/0
EMAIL_HOST=mail
EMAIL_PORT=1025
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
DEFAULT_FROM_EMAIL=no-reply@health.example
S3_ENDPOINT=http://storage:8333
S3_BUCKET=health-local
S3_REGION=eu-west-1
S3_ACCESS_KEY=
S3_SECRET_KEY=
# Next local dev only; Compose sends API traffic directly through its proxy.
API_INTERNAL_URL=http://127.0.0.1:8000

# M3 requires an active scanner and a wrapping key. Compose provisions local defaults.
# Generate a dedicated 32-byte URL-safe Fernet key and keep it with encrypted backups.
CLINICAL_MASTER_KEY=
# Private clamd host reachable by the backend on TCP 3310.
CLINICAL_CLAMAV_HOST=
# Dedicated random search key. Preserve it across restarts to keep the token index readable.
CLINICAL_SEARCH_KEY=
# AWS KMS key ARN, required outside DEBUG. Retain old keys during rotation.
CLINICAL_KMS_KEY_ID=
# Read-only R2 credentials for the offline import command.
LEGACY_R2_ENDPOINT=
LEGACY_R2_BUCKET=
LEGACY_R2_KEY=
LEGACY_R2_SECRET=
# Comma-separated old local wrapping keys, only during rotation or restore.
CLINICAL_PREVIOUS_MASTER_KEYS=

# M4 local synthetic development only. Enable with the Compose analysis profile.
CLINICAL_ANALYSIS_ENABLED=0

# M7. Optional DSN of a separate PostgreSQL research database, for research_refresh.
RESEARCH_DATABASE_DSN=
# Separate read-only role for approved research exports. Disabled by default.
RESEARCH_READ_DSN=
RESEARCH_EXPORT_ENABLED=0

# P2 HMAC key for tenant patient identifiers. Generate and keep with backups.
CLINICAL_IDENTITY_KEY=

# P3 synthetic laboratory workflow, available only with DJANGO_DEBUG=true.
CLINICAL_SAFETY_ENABLED=0

# Optional trusted Python adapter class for synthetic medication screening.
CLINICAL_MEDICATION_PROVIDER=

# P4 trusted PAdES/CAdES verification adapter. Publication is blocked without it.
CLINICAL_SIGNATURE_VERIFIER=
