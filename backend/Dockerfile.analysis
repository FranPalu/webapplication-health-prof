FROM python:3.14.5-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97 AS build
RUN apt-get update && apt-get install -y --no-install-recommends ca-certificates curl cmake g++ make && rm -rf /var/lib/apt/lists/*
ADD https://codeload.github.com/ggml-org/llama.cpp/tar.gz/4762ad7316dcdec20016ab5985fb46a27902204d /tmp/llama.tar.gz
RUN mkdir /llama && tar -xzf /tmp/llama.tar.gz -C /llama --strip-components=1 && \
    cmake -S /llama -B /llama/build -DBUILD_SHARED_LIBS=OFF -DLLAMA_CURL=OFF -DGGML_NATIVE=OFF -DGGML_OPENMP=OFF -DLLAMA_BUILD_TESTS=OFF && \
    cmake --build /llama/build --target llama-cli -j 4

FROM python:3.14.5-slim@sha256:c845af9399020c7e562969a13689e929074a10fd057acd1b1fad06a2fb068e97
ENV PYTHONUNBUFFERED=1 PYTHONDONTWRITEBYTECODE=1 OMP_THREAD_LIMIT=2 TESSDATA_PREFIX=/opt/tessdata
RUN apt-get update && apt-get install -y --no-install-recommends tesseract-ocr poppler-utils && rm -rf /var/lib/apt/lists/*
ADD --checksum=sha256:b8f89e1e785118dac4d51ae042c029a64edb5c3ee42ef73027a6d412748d8827 https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/ita.traineddata /opt/tessdata/ita.traineddata
ADD --checksum=sha256:7d4322bd2a7749724879683fc3912cb542f19906c83bcc1a52132556427170b2 https://raw.githubusercontent.com/tesseract-ocr/tessdata_fast/4.1.0/eng.traineddata /opt/tessdata/eng.traineddata
RUN chmod 0444 /opt/tessdata/*.traineddata
COPY --from=build /llama/build/bin/llama-cli /usr/local/bin/
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt && useradd --uid 10001 --create-home health
COPY --chown=health:health . .
USER health
